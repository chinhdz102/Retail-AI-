{
  "dataset_id": "winmart_vietnamese_catalog_recommendation_v1",
  "language_scope": "Vietnamese only",
  "description": "Bộ kiểm thử tư vấn sản phẩm theo intent, ràng buộc và trạng thái catalog. Các tiêu chí dùng category, tên hàng, giá và khuyến mãi đã xác minh thay vì khóa vào một SKU.",
  "research_basis": [
    "ShoppingBench: intent-grounded constraints and terminal-state checks",
    "Shopping Reasoning Bench: atomic rubrics across recommendation, inquiry, comparison and navigation",
    "ToolSandbox and tau-bench: stateful multi-turn milestones and minefields",
    "RAGAS: retrieval relevance and grounded answer checks"
  ],
  "cases": [
    {
      "case_id": "occasion_hotpot",
      "suite": "occasion",
      "reasoning_category": "Product Recommendation",
      "reasoning_subcategory": "Open-ended Discovery",
      "turns": [{
        "text": "t muốn ăn lẩu thì ăn với cái gì",
        "required": {
          "min_products": 3,
          "required_categories": ["Thịt", "Hải Sản"],
          "allowed_categories": ["Thịt", "Hải Sản", "Hải Sản Đông Lạnh", "Rau Lá", "Củ, Quả"],
          "name_not_contains": ["nước mắm", "xay", "nộm"],
          "text_not_contains": ["catalog", "snapshot"]
