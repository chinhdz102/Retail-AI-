{
  "dataset_id": "retail_vietnamese_text_sales_flow_v6_snapshot_dev_20261020",
  "language_scope": "Vietnamese only",
  "description": "10 development sessions / 50 turns against the configured WinMart JSON snapshot. Covers natural customer requests, product variants, snapshot freshness, current-stock abstention, recommendations, injection and demo support. This is development data, not blind held-out data.",
  "catalog_scope": "Configured SnapshotProductRepository using data/winmart_products.json; no live PostgreSQL or branch inventory.",
  "research_informed_by": [
    "https://arxiv.org/abs/2406.12045",
    "https://arxiv.org/abs/2408.04682",
    "https://aclanthology.org/2024.eacl-demo.16/"
  ],
  "cases": [
    {
      "case_id": "snapshot_coca_price_shelf_stock_freshness",
      "tags": ["dev", "snapshot", "multi_turn", "freshness", "stock_abstention"],
      "turns": [
        {
          "text": "Coca Zero chai 600ml giá bao nhiêu?",
          "expected_product_ids": ["WIN_10194711"],
          "must_contain": ["9.900đ", "giá tham khảo"],
          "must_not_contain": ["15/09/2026", "còn hàng nhé"]
        },
        {
          "text": "Nó ở kệ nào?",
          "expected_product_ids": ["WIN_10194711"],
          "must_contain": ["sơ đồ kệ đề xuất", "A10-B04-L02-P01"],
          "must_not_contain": ["đang được bày chắc chắn"]
        },
        {
          "text": "Hiện còn hàng không?",
          "expected_product_ids": ["WIN_10194711"],
          "must_contain": ["tồn hiện tại chưa được xác minh"],
          "must_not_contain": ["còn 232 chai", "chắc chắn còn"]
        },
        {
          "text": "Dữ liệu này cập nhật ngày nào?",
          "expected_product_ids": ["WIN_10194711"],
          "must_contain": ["15/09/2026", "chưa thể xác nhận"]
        },
        {
          "text": "Vậy giá ở cửa hàng hôm nay đã được xác nhận chưa?",
          "expected_product_ids": ["WIN_10194711"],
          "must_contain": ["giá tham khảo", "có thể khác"],
          "must_not_contain": ["15/09/2026"]
        }
      ]
    },
    {
