{
  "dataset_id": "retail_vietnamese_text_sales_flow_v5_heldout_20261020",
  "language_scope": "Vietnamese only",
  "description": "Fresh held-out set frozen before live execution on 2026-10-20. Ten continuous five-turn customer sessions cover paraphrases, context correction, recommendation constraints, catalog ambiguity, expired products, unsupported health claims, prompt injection, customer support, comparison, cart writes, and checkout boundaries. Do not tune implementation against this set.",
  "catalog_scope": "Six-product demo catalog only; does not represent live PostgreSQL, branch inventory, or sales popularity.",
  "research_informed_by": [
    "https://arxiv.org/abs/2406.12045",
    "https://arxiv.org/abs/2408.04682",
    "https://aclanthology.org/2024.eacl-demo.16/"
  ],
  "cases": [
    {
      "case_id": "walkup_water_query_and_cart_revision",
      "tags": ["heldout", "regional_register", "multi_intent", "cart_mutation"],
      "turns": [
        {
          "text": "Cho tui hỏi chai nước suối nửa lít giá nhiêu, nằm dãy nào vậy?",
          "expected_product_ids": ["WATER01"],
          "must_contain": ["7.000", "A1-L1"]
        },
        {
          "text": "Còn bao nhiêu chai?",
          "expected_product_ids": ["WATER01"],
          "must_contain": ["40"]
        },
        {
          "text": "Lấy giúp tui 2 chai bỏ vô giỏ.",
          "expected_product_ids": ["WATER01"],
          "expected_state": "CART_ACTIVE",
          "expected_cart_items": {"WATER01": 2}
        },
        {
          "text": "Giảm còn 1 chai thôi.",
          "expected_state": "CART_ACTIVE",
          "expected_cart_items": {"WATER01": 1}
        },
        {
          "text": "Tổng giỏ giờ bao nhiêu?",
          "expected_state": "CART_ACTIVE",
          "expected_cart_items": {"WATER01": 1},
          "must_contain": ["7.000"]
        }
      ]
    },
    {
