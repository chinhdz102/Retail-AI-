APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://retail:retail@localhost:5432/retail
CATALOG_REPOSITORY=demo
CATALOG_SNAPSHOT_PATH=data/thanh_lam_products.json
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=replace-with-local-secret
QWEN_MODEL=replace-with-qwen-model
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=replace-with-local-secret
GROQ_MODEL=qwen/qwen3.8-27b
# JSON mode avoids provider schema-generation retries; local validation stays on.
GROQ_STRICT_OUTPUTS=false
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL_2=openai/gpt-oss-20b
# One Vietnamese decoder per turn, with no prompt or transcript rewriting.
STT_PROVIDER=groq
# STT_PROVIDER=azure uses the existing Azure speech key/region instead.
WHISPER_TIMEOUT_SECONDS=25
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_API_KEY_FALLBACK_3=
GROQ_API_KEY_FALLBACK_4=
GROQ_API_KEY_FALLBACK_5=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TIMEOUT_SECONDS=20
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=replace-with-local-secret
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
ELEVENLABS_SPEED=0.88
ELEVENLABS_VI_VOICE_NAME=Giang - Northern female Narrator
ELEVENLABS_VI_VOICE_ID=
ELEVENLABS_VI_FALLBACK_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TIMEOUT_SECONDS=45
