APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://retail:retail@localhost:5432/retail
# Snapshot prices are references only; current inventory is not verified.
CATALOG_REPOSITORY=snapshot
CATALOG_SNAPSHOT_PATH=data/thanh_lam_products.json
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800
# Per-process limits; in-flight includes running and queued catalog jobs.
CATALOG_TOOL_WORKERS=8
CATALOG_TOOL_MAX_IN_FLIGHT=16
# Driver deadlines also apply to branch information and connection cleanup.
POSTGRES_CONNECT_TIMEOUT_SECONDS=2.0
POSTGRES_COMMAND_TIMEOUT_SECONDS=2.5
# Optional 30-day sales ranking counts for local catalog baseline; production always ignores this flag.
DEMO_SALES_ENABLED=false
DEMO_SALES_DATABASE_PATH=data/demo_sales.sqlite3
# Optional Vietnamese consultation flag for local development environments.
# Live review still finds unsupported claims and unsuitable baskets; see docs/reports.
CUSTOMER_CONSULTATION_ENABLED=false
CUSTOMER_CONSULTATION_LOCAL_FALLBACK_ENABLED=false
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=replace-with-local-secret
QWEN_MODEL=replace-with-qwen-model
# Optional dedicated OpenAI-compatible chat LLM provider (e.g. Token Harbor DeepSeek Flash).
# When CHAT_LLM_API_KEY is set, all chat/consultation calls use it while Groq remains available for STT.
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
CHAT_LLM_FALLBACK_MODEL=
CHAT_LLM_FALLBACK_MODEL_2=
CHAT_LLM_CONSULTATION_REVIEW_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=replace-with-local-secret
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_API_KEY_FALLBACK_3=
GROQ_API_KEY_FALLBACK_4=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL_2=openai/gpt-oss-20b
# Qwen structured decisions: use none to reduce reasoning tokens after live evaluation.
GROQ_STRUCTURED_REASONING_EFFORT=low
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_FALLBACK_MODEL=whisper-large-v3-turbo
VIETNAMESE_ASR_BACKEND=groq
VIETNAMESE_ASR_MODEL_DIR=
VIETNAMESE_ASR_DECODING=greedy_search
VIETNAMESE_ASR_VERIFY_UNCERTAIN=false
GROQ_CONSULTATION_REVIEW_MODEL=openai/gpt-oss-120b
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TIMEOUT_SECONDS=20
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=replace-with-local-secret
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
ELEVENLABS_SPEED=0.88
ELEVENLABS_VI_VOICE_NAME=Giang - Northern female Narrator
ELEVENLABS_VI_VOICE_ID=
ELEVENLABS_VI_FALLBACK_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_EN_VOICE_NAME=Sarah - Mature, Reassuring, Confident
ELEVENLABS_EN_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_ZH_VOICE_NAME=River - Relaxed, Neutral, Informative
ELEVENLABS_ZH_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVENLABS_TIMEOUT_SECONDS=45

# Manager escalation notifications (priority: Zalo -> Messenger -> Gmail).
STORE_NAME=Thanh Lam Mart
MANAGER_NOTIFY_PRIORITY=zalo_bot,zalo_oa,zalo_webhook,messenger,gmail
MANAGER_NOTIFY_TIMEOUT_SECONDS=8.0

# 1) Zalo Bot Platform (https://bot.zaloplatforms.com) — fastest setup for personal Zalo.
ZALO_BOT_TOKEN=
ZALO_BOT_CHAT_ID=
ZALO_BOT_API_BASE=https://bot-api.zaloplatforms.com

# 2) Zalo Official Account (OA) OpenAPI v3.0.
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_MANAGER_USER_ID=

# 3) Zalo Custom Webhook (n8n / Make / Zalo bridge).
ZALO_WEBHOOK_URL=
ZALO_WEBHOOK_SECRET=

# 4) Facebook Messenger Platform Send API.
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_MANAGER_PSID=
MESSENGER_API_VERSION=v21.0

# 5) Gmail SMTP fallback (enable 2FA -> create 16-char Google App Password).
MANAGER_GMAIL_SENDER=
MANAGER_GMAIL_APP_PASSWORD=
MANAGER_GMAIL_TO=
MANAGER_GMAIL_SMTP_HOST=smtp.gmail.com
MANAGER_GMAIL_SMTP_PORT=465

# PayOS VietQR Checkout (https://my.payos.vn)
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:8000/?payos=success
PAYOS_CANCEL_URL=http://localhost:8000/?payos=cancel

# Docker runtime overrides (set automatically by docker-compose.yml)
# APP_PORT=8000
# FRONTEND_DIST_DIR=/app/static
